#This macro can not be executed standalone

/DRsim/action/useHepMC False
/DRsim/action/useCalib False

#/vis/disable
#/run/numberOfThreads 1
/run/initialize
/run/verbose 1

/gun/direction  0 0 1

/DRsim/generator/z0 -1000
/DRsim/generator/randx 10
/DRsim/generator/randz 10

/gun/particle e-
/gun/energy 100 MeV
/run/beamOn 1


